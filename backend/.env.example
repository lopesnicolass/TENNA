# Copie este arquivo para ".env" (na pasta backend) e preencha os valores.
# O arquivo .env NÃO deve ser enviado ao GitHub.

# Porta do servidor (padrão: 3000)
PORT=3000

# Chave usada para assinar os tokens de login (use um texto longo e aleatório)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Endereço do front-end (usado nos links de redefinição de senha)
FRONTEND_URL=http://localhost:5173

# Envio de e-mails de recuperação de senha (opcional em ambiente local)
RESEND_API_KEY=
EMAIL_FROM=

# Conta de administrador criada pelo script "node criarAdmin.js"
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
