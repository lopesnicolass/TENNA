# Dependências e arquivos gerados
**/node_modules/
**/dist/
**/coverage/
**/.vite/
*.log
npm-debug.log*

# Segredos: somente exemplos podem ser versionados
**/.env
**/.env.*
!**/.env.example

# Banco, backups e dados locais (preservar as pastas)
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*
*.bak
*.backup
backend/banco/*
!backend/banco/.gitkeep
# Único banco versionado: o de DEMONSTRAÇÃO (sem dados de usuários reais)
!backend/banco/demo/
!backend/banco/demo/vestibulinho-demo.sqlite

# PDFs e arquivos enviados pelos usuários
backend/uploads/**
!backend/uploads/
!backend/uploads/provas/
!backend/uploads/provas/.gitkeep
